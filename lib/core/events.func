#!/usr/bin/env bash
#
# Module: events.func (PatchMox)
# Description: Event bus primitives for PatchMox. Emits canonical JSON events
#              and dispatches them to policy evaluation, actions, and channels.
#              No persistent event journal is kept; queue files are the durable
#              record for actions that require it.
# Author: Frederik S. (fs1n) and PatchMox Contributors
# Date: 2026-07-15
#
# Dependencies: jq, date
# Environment: SCRIPT_DIR, STATE_DIR
# Usage: source lib/core/events.func; dispatch_event "update.available" "$payload"

# @function build_event
# @description Builds a canonical JSON event with event_id, timestamp, type, and payload.
# @args event_type (string): event type, e.g. "update.available"
#       payload (string): JSON object with event-specific fields
# @returns JSON event on stdout, empty on invalid payload
function build_event() {
    local event_type="${1:-unknown}"
    local payload="${2:-}"
    if [[ -z "$payload" ]]; then
        payload="{}"
    fi

    # Validate that payload is valid JSON
    if ! jq -e . >/dev/null 2>&1 <<< "$payload"; then
        log_error "build_event received invalid JSON payload for type '$event_type': $payload"
        echo "ERROR: build_event received invalid JSON payload for type '$event_type': $payload" >&2
        return 1
    fi

    local event_id
    event_id="$(cat /proc/sys/kernel/random/uuid 2>/dev/null || echo "$(date +%s%N)-$$")"

    log_debug "Building event: type=$event_type event_id=$event_id"
    jq -n \
        --arg event_id "$event_id" \
        --arg timestamp "$(date -u '+%Y-%m-%dT%H:%M:%SZ')" \
        --arg type "$event_type" \
        --argjson payload "$payload" \
        '{event_id: $event_id, timestamp: $timestamp, type: $type, payload: $payload}'
}

# @function build_notification_body
# @description Builds an HTML notification body from a canonical event using
#              the email template. Falls back to plain text if template missing.
# @args event_json (string): canonical PatchMox event
# @returns HTML or plain text body on stdout
function build_notification_body() {
    local event_json="${1:-}"
    local event_type vmid node components
    event_type=$(echo "$event_json" | jq -r '.type // "unknown"')
    vmid=$(echo "$event_json" | jq -r '.payload.vmid // "unknown"')
    node=$(echo "$event_json" | jq -r '.payload.node // "unknown"')
    components=$(echo "$event_json" | jq -r '.payload.components | join(", ") // "none"')

    local virtio_current virtio_latest qemu_current qemu_latest
    virtio_current=$(echo "$event_json" | jq -r '.payload.current.virtio // "unknown"')
    virtio_latest=$(echo "$event_json" | jq -r '.payload.latest.virtio // "unknown"')
    qemu_current=$(echo "$event_json" | jq -r '.payload.current.qemu_ga // "unknown"')
    qemu_latest=$(echo "$event_json" | jq -r '.payload.latest.qemu_ga // "unknown"')

    local template_file="${SCRIPT_DIR}/templates/html/email-template.html"
    local release_date last_checked update_link
    release_date=$(echo "$event_json" | jq -r '.payload.latest.virtio_release // .payload.latest.qemu_ga_release // "unknown"')
    last_checked=$(date '+%Y-%m-%d %H:%M:%S')

    # Build update link if webhook is configured
    if [[ -n "${WEBHOOK_HOST:-}" && -n "${WEBHOOK_SECRET:-}" ]]; then
        update_link="http://${WEBHOOK_HOST}:${WEBHOOK_PORT:-9000}/hooks/${vmid}?token=${WEBHOOK_SECRET}"
    else
        update_link="https://github.com/fs1n/PVE-QEMU-VirtIO-Updater"
    fi

    if [[ "$event_type" == "update.available" && -f "$template_file" ]]; then
        # Load and populate the HTML template
        local template
        template=$(cat "$template_file")

        # Replace placeholders
        template="${template//\{\{NODE_NAME\}\}/$node}"
        template="${template//\{\{VMID\}\}/$vmid}"
        template="${template//\{\{VM_NAME\}\}/VM $vmid}"
        template="${template//\{\{CURRENT_VIRTIO_VERSION\}\}/$virtio_current}"
        template="${template//\{\{LATEST_VIRTIO_VERSION\}\}/$virtio_latest}"
        template="${template//\{\{CURRENT_QEMU_GA_VERSION\}\}/$qemu_current}"
        template="${template//\{\{LATEST_QEMU_GA_VERSION\}\}/$qemu_latest}"
        template="${template//\{\{RELEASE_DATE\}\}/$release_date}"
        template="${template//\{\{LAST_CHECKED\}\}/$last_checked}"
        template="${template//\{\{UPDATE_LINK\}\}/$update_link}"

        echo "$template"
    else
        # Plain text fallback
        local body="PatchMox detected available updates for VM $vmid on node $node.

Components needing update: $components

"
        if [[ "$components" == *"virtio"* ]]; then
            body+="VirtIO Drivers: $virtio_current → $virtio_latest
"
        fi
        if [[ "$components" == *"qemu-ga"* ]]; then
            body+="QEMU Guest Agent: $qemu_current → $qemu_latest
"
        fi
        body+="

Update recommended during your next maintenance window."
        echo "$body"
    fi
}

# @function get_notification_content_type
# @description Returns the content type for notifications based on whether
#              the HTML template was used.
# @args event_json (string): canonical PatchMox event
# @returns "text/html" or "text/plain" on stdout
function get_notification_content_type() {
    local event_json="${1:-}"
    local event_type
    event_type=$(echo "$event_json" | jq -r '.type // "unknown"')

    local template_file="${SCRIPT_DIR}/templates/html/email-template.html"
    if [[ "$event_type" == "update.available" && -f "$template_file" ]]; then
        echo "text/html"
    else
        echo "text/plain"
    fi
}
# @function emit_event
# @description Builds and emits a canonical JSON event to stdout.
#              This is the low-level primitive. Prefer dispatch_event which
#              also routes to policy, actions, and channels.
# @args event_type (string): event type, e.g. "update.available"
#       payload (string): JSON object with event-specific fields
# @returns 0 on success, 1 on failure
function emit_event() {
    build_event "$@"
}

# @function dispatch_event
# @description Builds a canonical event, logs it, evaluates policy, and routes
#              the decision to actions (enqueue) and channels (notifications).
#              This is the main entry point for the event pipeline.
# @args event_type (string): event type, e.g. "update.available"
#       payload (string): JSON object with event-specific fields
# @returns JSON decision on stdout (for callers that need it), empty on error
function dispatch_event() {
    local event_type="${1:-unknown}"
    local payload="${2:-}"

    local event_json
    event_json=$(build_event "$event_type" "$payload") || return 1

    # Log the event at debug level for visibility.
    log_debug "Event: $event_type ($event_json)"

    # Evaluate policy for this event.
    local decision
    decision=$(evaluate_policy "$event_json")

    # Route to channels if policy says notify.
    local should_notify
    should_notify=$(echo "$decision" | jq -r '.notify // false')
    if [[ "$should_notify" == "true" ]]; then
        local subject body content_type
        subject="PatchMox: $event_type"
        body=$(build_notification_body "$event_json")
        content_type=$(get_notification_content_type "$event_json")
        log_debug "Dispatching notification for event $event_type to channels (content_type: $content_type)"
        notification_send "$subject" "$body" "$content_type" || log_warn "Notification delivery failed for event $event_type"
    else
        log_debug "Notification suppressed for event $event_type (policy: notify=false)"
    fi

    # Route to actions based on policy decision.
    local action
    action=$(echo "$decision" | jq -r '.action // "none"')
    if [[ "$action" == "auto-update" ]]; then
        log_debug "Policy action=auto-update for event $event_type — enqueuing job"
        enqueue_job "$event_json" "$decision"
    else
        log_debug "Policy action=$action for event $event_type — no enqueue"
    fi

    # Echo the decision so callers can use it.
    echo "$decision"
}

# @function build_check_started_payload
# @description Builds the payload for check.started event.
# @args virtio_version (string): latest VirtIO version
#       qemu_ga_version (string): latest QEMU GA version
# @returns JSON payload on stdout
function build_check_started_payload() {
    local virtio_version="${1:-unknown}"
    local qemu_ga_version="${2:-unknown}"
    jq -n \
        --arg virtio_version "$virtio_version" \
        --arg qemu_ga_version "$qemu_ga_version" \
        '{virtio_version: $virtio_version, qemu_ga_version: $qemu_ga_version}'
}

# @function build_vm_checked_payload
# @description Builds the payload for vm.checked / update.available events.
# @args vmid, node, vmgenid, virtio_current, virtio_latest, qemu_current, qemu_latest, components_json
# @returns JSON payload on stdout
function build_vm_checked_payload() {
    local vmid="${1:-}"
    local node="${2:-}"
    local vmgenid="${3:-}"
    local virtio_current="${4:-}"
    local virtio_latest="${5:-}"
    local qemu_current="${6:-}"
    local qemu_latest="${7:-}"
    local components_json="${8:-[]}"

    jq -n \
        --arg vmid "$vmid" \
        --arg node "$node" \
        --arg vmgenid "$vmgenid" \
        --arg virtio_current "$virtio_current" \
        --arg virtio_latest "$virtio_latest" \
        --arg qemu_current "$qemu_current" \
        --arg qemu_latest "$qemu_latest" \
        --argjson components "$components_json" \
        '{
            vmid: $vmid,
            node: $node,
            vmgenid: $vmgenid,
            components: $components,
            current: {virtio: $virtio_current, qemu_ga: $qemu_current},
            latest: {virtio: $virtio_latest, qemu_ga: $qemu_latest}
        }'
}
