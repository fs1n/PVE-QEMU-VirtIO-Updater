#!/usr/bin/env bash
#
# Module: queue.func (PatchMox)
# Description: Filesystem-based job queue primitives for deferred update actions.
# Author: Frederik S. (fs1n) and PatchMox Contributors
# Date: 2026-07-15
#
# Dependencies: jq, date, mv, rm
# Environment: SCRIPT_DIR, QUEUE_DIR
# Usage: source lib/core/queue.func; enqueue_job "{event}" "{decision}"

: "${QUEUE_DIR:=${SCRIPT_DIR}/queue}"
PATCHMOX_QUEUE_DIR_INITIALIZED="false"

# @function init_queue_dirs
# @description Ensures the queue subdirectories exist. Idempotent.
# @returns 0 on success, 1 on error
function init_queue_dirs() {
    if [[ "$PATCHMOX_QUEUE_DIR_INITIALIZED" == "true" ]]; then
        return 0
    fi

    for sub in pending claimed running done failed; do
        if [[ ! -d "${QUEUE_DIR}/${sub}" ]]; then
            mkdir -p "${QUEUE_DIR}/${sub}" 2>/dev/null || {
                log_error "Cannot create queue directory: ${QUEUE_DIR}/${sub}"
                return 1
            }
        fi
    done

    PATCHMOX_QUEUE_DIR_INITIALIZED="true"
}

# @function enqueue_job
# @description Writes a pending job to the queue. Phase 1 stub: creates the file
#              but no worker consumes it yet.
# @args event_json (string): canonical PatchMox event that triggered the job
#       decision_json (string): policy decision
# @returns 0 on success, 1 on error
function enqueue_job() {
    local event_json="${1:-}"
    local decision_json="${2:-}"

    init_queue_dirs || return 1

    local job_id
    job_id="$(cat /proc/sys/kernel/random/uuid 2>/dev/null || echo "$(date +%s%N)-$$")"

    local job
    job=$(jq -n \
        --arg job_id "$job_id" \
        --arg queued_at "$(date -u '+%Y-%m-%dT%H:%M:%SZ')" \
        --argjson event "${event_json:-null}" \
        --argjson decision "${decision_json:-null}" \
        '{job_id: $job_id, type: "auto-update", status: "pending", queued_at: $queued_at, attempts: 0, max_attempts: 3, next_attempt_at: $queued_at, event: $event, decision: $decision}')

    local job_file="${QUEUE_DIR}/pending/${job_id}.json"
    if echo "$job" > "$job_file"; then
        log_debug "Enqueued job ${job_id}"
        return 0
    else
        log_error "Failed to write pending job: $job_file"
        return 1
    fi
}

# @function list_eligible_pending_jobs
# @description Lists pending job files whose next_attempt_at is in the past.
# @returns newline-separated list of absolute file paths, oldest first
function list_eligible_pending_jobs() {
    init_queue_dirs || return 1

    local now
    now=$(date -u '+%Y-%m-%dT%H:%M:%SZ')

    find "${QUEUE_DIR}/pending" -maxdepth 1 -type f -name '*.json' -print0 2>/dev/null | \
        xargs -0 -r ls -tr 2>/dev/null | \
        while IFS= read -r job_file; do
            local next
            next=$(jq -r '.next_attempt_at // ""' "$job_file" 2>/dev/null)
            if [[ -n "$next" && ( "$next" < "$now" || "$next" == "$now" ) ]]; then
                echo "$job_file"
            fi
        done
}

# @function claim_job
# @description Atomically moves the oldest eligible pending job to claimed/.
# @returns JSON object with job_id, claimed_file, and job data on stdout; empty on failure
function claim_job() {
    init_queue_dirs || return 1

    local job_file
    job_file=$(list_eligible_pending_jobs | head -n1)

    if [[ -z "$job_file" ]]; then
        return 1
    fi

    local job_id
    job_id=$(basename "$job_file" .json)

    local claimed_file
    claimed_file="${QUEUE_DIR}/claimed/${job_id}.json"

    if mv "$job_file" "$claimed_file" 2>/dev/null; then
        jq -n \
            --arg job_id "$job_id" \
            --arg claimed_file "$claimed_file" \
            --argjson job "$(cat "$claimed_file")" \
            '{job_id: $job_id, claimed_file: $claimed_file, job: $job}'
    else
        log_warn "Failed to claim job $job_id"
        return 1
    fi
}

# @function finish_job
# @description Moves a claimed job to done/ and appends a result.
# @args claimed_file (string): path to the claimed job file
#       result_json (string): result payload to merge into the job record
function finish_job() {
    local claimed_file="${1:-}"
    local result_json="${2:-}"
    if [[ -z "$result_json" ]]; then
        result_json="{}"
    fi

    if [[ ! -f "$claimed_file" ]]; then
        log_warn "finish_job called with missing claimed file: $claimed_file"
        return 1
    fi

    local job_id
    job_id=$(basename "$claimed_file" .json)

    local finished_at
    finished_at=$(date -u '+%Y-%m-%dT%H:%M:%SZ')

    local done_file
    done_file="${QUEUE_DIR}/done/${job_id}.json"

    jq --argjson result "$result_json" \
       --arg finished_at "$finished_at" \
       '.status = "done" | .finished_at = $finished_at | .result = $result' \
       "$claimed_file" > "$done_file" 2>/dev/null || {
        log_error "Failed to write done job file: $done_file"
        return 1
    }

    rm -f "$claimed_file"
    log_info "Job $job_id finished."
}

# @function fail_job
# @description Returns a claimed job to pending/ with backoff or moves it to failed/.
# @args claimed_file (string): path to the claimed job file
#       error_message (string): human-readable failure reason
function fail_job() {
    local claimed_file="${1:-}"
    local error_message="${2:-unknown error}"

    if [[ ! -f "$claimed_file" ]]; then
        log_warn "fail_job called with missing claimed file: $claimed_file"
        return 1
    fi

    local job_id
    job_id=$(basename "$claimed_file" .json)

    local attempts max_attempts
    attempts=$(jq -r '.attempts // 0' "$claimed_file")
    max_attempts=$(jq -r '.max_attempts // 3' "$claimed_file")

    attempts=$((attempts + 1))

    if [[ "$attempts" -ge "$max_attempts" ]]; then
        local failed_at
        failed_at=$(date -u '+%Y-%m-%dT%H:%M:%SZ')
        local failed_file
        failed_file="${QUEUE_DIR}/failed/${job_id}.json"
        jq --arg failed_at "$failed_at" \
           --arg error "$error_message" \
           --argjson attempts "$attempts" \
           '.status = "failed" | .failed_at = $failed_at | .error = $error | .attempts = $attempts' \
           "$claimed_file" > "$failed_file" 2>/dev/null || {
            log_error "Failed to write failed job file: $failed_file"
            return 1
        }
        rm -f "$claimed_file"
        log_warn "Job $job_id failed after $attempts attempt(s): $error_message"
        return 0
    fi

    # Exponential backoff: 5m, 15m, 45m, ...
    local backoff_minutes
    backoff_minutes=$((5 * 3 ** (attempts - 1)))
    local next_attempt_at
    next_attempt_at=$(date -u -d "+${backoff_minutes} minutes" '+%Y-%m-%dT%H:%M:%SZ')

    local pending_file
    pending_file="${QUEUE_DIR}/pending/${job_id}.json"
    jq --argjson attempts "$attempts" \
       --arg next_attempt_at "$next_attempt_at" \
       --arg last_error "$error_message" \
       '.status = "pending" | .attempts = $attempts | .next_attempt_at = $next_attempt_at | .last_error = $last_error' \
       "$claimed_file" > "$pending_file" 2>/dev/null || {
        log_error "Failed to write pending job file: $pending_file"
        return 1
    }
    rm -f "$claimed_file"
    log_warn "Job $job_id failed (attempt $attempts of $max_attempts), retry at $next_attempt_at: $error_message"
}
